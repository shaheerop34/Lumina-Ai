# Copy this file's contents into Vercel → Project → Settings → Environment
# Variables (do NOT commit a real .env file to git).

# ---- AI provider key (set only the ONE you use in app.js's PROXY_PROVIDER) ----
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Supabase (used for accounts + sessions) ----
# Find these in Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (used to send "forgot password" reset emails) ----
# Get a key at https://resend.com/api-keys (free tier: 3,000 emails/month).
# Without a verified sending domain, Resend only lets you send to the
# email address on your own Resend account — fine for testing, but you'll
# need to verify a domain (Resend → Domains) before real users' reset
# emails will actually deliver.
RESEND_API_KEY=
# Optional: defaults to "Lumina AI <onboarding@resend.dev>" (Resend's
# shared test sender). Set this to e.g. "Lumina AI <noreply@yourdomain.com>"
# once you've verified a domain.
RESEND_FROM=
