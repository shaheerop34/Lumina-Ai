# Copy this file's contents into Vercel → Project → Settings → Environment
# Variables (do NOT commit a real .env file to git).

# ---- AI provider key (set only the ONE you use in app.js's PROXY_PROVIDER) ----
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Supabase (used for accounts + sessions) ----
# Find these in Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gmail SMTP (used to send "forgot password" reset emails) ----
# Free, and works for any recipient (no domain needed). Requires 2FA
# enabled on the Gmail account, then generate an App Password at
# https://myaccount.google.com/apppasswords (select app "Mail").
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=
